3c:["$","article","Unresolved Tax Debts and Unfiled Returns",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Unresolved Tax Debts and Unfiled Returns"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"The IRS and USCIS share information regarding your financial compliance. A refusal to file taxes or ignoring outstanding IRS debts is an immediate red flag for good moral character."}]]}]
