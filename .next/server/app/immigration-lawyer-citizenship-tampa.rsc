44:["$","article","Seeking Federal Court Review After an Administrative Hearing",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Seeking Federal Court Review After an Administrative Hearing"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"You still have rights if your N-336 is unfairly denied by the second officer. You have the ability to seek a de novo review in a U.S. District Court and let a federal judge decide."}]]}]
