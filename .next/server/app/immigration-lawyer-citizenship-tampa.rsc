4:T7ce,{"@context":"https://schema.org","@graph":[{"@type":"FAQPage","@id":"https://www.vienlaw.com/immigration-lawyer-citizenship-tampa#faq","mainEntity":[{"@type":"Question","name":"Can I Apply for U.S. Citizenship if My Green Card Has Expired?","acceptedAnswer":{"@type":"Answer","text":"An expired Green Card does not mean you have lost your permanent resident status. You may be required to file Form I-90 to renew the card before or concurrently with your N-400, depending on current USCIS guidelines."}},{"@type":"Question","name":"Do I Have to Take the Citizenship Test if I Am Over 50 Years Old?","acceptedAnswer":{"@type":"Answer","text":"Age alone does not automatically excuse you from testing requirements. You are exempt from the English language requirement and may take the civics test in your native language only if you are 50 or older and have held a Green Card for at least 20 years. The civics test is always required unless a formal medical exception applies to your case."}},{"@type":"Question","name":"Can an Immigration Lawyer Attend My Naturalization Interview With Me?","acceptedAnswer":{"@type":"Answer","text":"You have the absolute right to have an attorney present at your naturalization interview by filing Form G-28. Your lawyer can clarify complex legal questions posed by the officer during the examination."}}]},{"@type":"ImageObject","@id":"https://www.vienlaw.com/immigration-lawyer-citizenship-tampa#attorney-image","contentUrl":"https://www.vienlaw.com/images/citizenship-tampa/attorney-viengphone-vongsyprasom.webp","url":"https://www.vienlaw.com/images/citizenship-tampa/attorney-viengphone-vongsyprasom.webp","name":"Attorney Viengphone Vongsyprasom, Esq.","caption":"Viengphone Vongsyprasom, Esq. — Florida Bar member serving Tampa citizenship and naturalization clients in English and Lao.","description":"Attorney Viengphone Vongsyprasom, Esq., Tampa immigration and citizenship lawyer at Vien Law","width":900,"height":1318,"encodingFormat":"image/webp"