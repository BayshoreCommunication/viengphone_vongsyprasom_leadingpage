1a:["$","section",null,{"id":"complex-cases","className":"scroll-mt-16 py-12 md:py-16 border-y border-[#e4dfd3] bg-white","children":["$","div",null,{"className":"mx-auto px-5 max-w-[1080px]","children":[["$","div",null,{"className":"mb-2 text-[0.75rem] font-semibold uppercase tracking-[3px] text-rose","children":"Know the risks"}],["$","h2",null,{"className":"mb-3 text-[1.55rem] font-normal leading-tight tracking-wide text-ink md:text-[2rem]","children":"How Complex and High-Risk Tampa Cases Affect Citizenship Applications"}],["$","p",null,{"className":"mb-8 max-w-[700px] text-[1.02rem] text-[#51596b]","children":"It is essential that you have a thorough legal risk assessment done before submitting your forms. If you neglect to do this, you may be refused and could be placed into deportation proceedings."}],["$","div",null,{"className":"grid gap-4","style":{"gridTemplateColumns":"repeat(auto-fit, minmax(min(300px, 100%), 1fr))"},"children":[["$","article","Criminal Convictions and Pending Charges in Florida",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Criminal Convictions and Pending Charges in Florida"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Some crimes will permanently disqualify you from becoming a citizen. However, there are other crimes that will only temporarily affect your \"good character\" period meaning you can apply after a period of time has passed."}]]}],["$","article","Previous Deportation Proceedings or Removal Orders",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Previous Deportation Proceedings or Removal Orders"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"If you have an old or pending removal order it can be extremely dangerous to make a new application. This can inform the immigration authorities of your whereabouts and result in active attempts to remove you."}]]}],["$","article","Extended Absences From the United States",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Extended Absences From the United States"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Longer trips will affect your continuous residence. If you are away for more than a year then you will usually lose it completely and have to start again."}]]}],["$","article","Previous Visa Fraud or Immigration Misrepresentation",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Previous Visa Fraud or Immigration Misrepresentation"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Officers look back at how you obtained your original Green Card during the naturalization process. The government will deny your citizenship and likely revoke your permanent residence if they discover any past fraud."}]]}],"$L3c","$L3d","$L3e","$L3f","$L40"]}]]}]}]
1b:["$","section",null,{"id":"denied-or-delayed","className":"scroll-mt-16 py-12 md:py-16 bg-cream","children":["$","div",null,{"className":"mx-auto px-5 max-w-[1080px]","children":["$undefined",["$","h2",null,{"className":"mb-3 text-[1.55rem] font-normal leading-tight tracking-wide text-ink md:text-[2rem]","children":"Why Citizenship Applicants Get Denied or Delayed Without an Immigration Lawyer in Tampa, Florida"}],["$","p",null,{"className":"mb-8 max-w-[700px] text-[1.02rem] text-[#51596b]","children":"Simple clerical mistakes and failure to pay attention to what you are eligible for can cost thousands of applicants. A qualified attorney will help avoid any issues that may come up during your interview."}],["$","div",null,{"className":"grid gap-4","style":{"gridTemplateColumns":"repeat(auto-fit, minmax(min(420px, 100%), 1fr))"},"children":[["$","article","Extended International Travel That Raises Residence Concerns",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-white","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Extended International Travel That Raises Residence Concerns"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"A lot of applicants fail to take into consideration how many long international trips they are making over the 5 year period. This will lead to physical presence or continuous residence issues."}]]}],["$","article","Missing Selective Service Registration Information",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-white","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Missing Selective Service Registration Information"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Failure to register is a big issue. If you can not prove that it was an innocent mistake then you will almost certainly be denied."}]]}],["$","article","Criminal History Disclosures That Conflict With Court Records",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-white","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Criminal History Disclosures That Conflict With Court Records"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"It is common for people to forget to disclose small citations that have been cleared by a judge years ago. USCIS will interpret this as being untruthful and deny your case on grounds of poor moral character."}]]}],["$","article","Unresolved Tax Issues That Raise Good Moral Character Concerns",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-white","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Unresolved Tax Issues That Raise Good Moral Character Concerns"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"An application submitted without an active IRS payment plan in place is a terrible strategy. A lack of proof regarding your tax compliance will almost certainly stall or end your case."}]]}],"$L41","$L42","$L43"]}]]}]}]
1c:["$","section",null,{"id":"after-denial","className":"scroll-mt-16 py-12 md:py-16 border-y border-[#e4dfd3] bg-white","children":["$","div",null,{"className":"mx-auto px-5 max-w-[1080px]","children":[["$","div",null,{"className":"mb-2 text-[0.75rem] font-semibold uppercase tracking-[3px] text-rose","children":"You still have options"}],["$","h2",null,{"className":"mb-3 text-[1.55rem] font-normal leading-tight tracking-wide text-ink md:text-[2rem]","children":"What Options Are Available After a Citizenship Application Denial?"}],["$","p",null,{"className":"mb-8 max-w-[700px] text-[1.02rem] text-[#51596b]","children":"If you receive a denial letter, that doesn't mean your dream of citizenship is forever gone. The steps you can take next will depend on the circumstances of your situation and the reasons for the rejection."}],["$","div",null,{"className":"grid gap-4","style":{"gridTemplateColumns":"repeat(auto-fit, minmax(min(300px, 100%), 1fr))"},"children":[["$","article","Requesting a Hearing Through Form N-336",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Requesting a Hearing Through Form N-336"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"You may file Form N-336 within 30 days if you think USCIS made a mistake, based on a factual or legal error. This form requests a new hearing with a different, higher-level immigration officer to review the evidence."}]]}],["$","article","Addressing the Legal Issues Identified in the Denial Notice",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Addressing the Legal Issues Identified in the Denial Notice"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Your denial letter will contain details of what actually happened. Once you have done what is necessary to rectify the problem, whether it be paying back taxes or waiting until a criminal probation period ends, you can take steps to correct it."}]]}],["$","article","Submitting Additional Evidence for Administrative Review",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Submitting Additional Evidence for Administrative Review"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"The N-336 hearing gives you a second chance to prove your case. You have the opportunity to submit new, stronger documentation that cures the original deficiency pointed out by the first officer."}]]}],["$","article","Filing a New Naturalization Application When Eligible",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Filing a New Naturalization Application When Eligible"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"The most practical strategy is sometimes just a matter of patience. You can simply wait until a temporary bar has passed and file a fresh N-400 with a clean record."}]]}],"$L44"]}]]}]}]
