1e:["$","section",null,{"id":"$undefined","className":"scroll-mt-16 py-12 md:py-16 bg-cream","children":["$","div",null,{"className":"mx-auto px-5 max-w-[1080px]","children":["$undefined","$undefined","$undefined",["$","div",null,{"className":"grid items-start gap-12 md:grid-cols-2","children":[["$","div",null,{"id":"processing-time","className":"scroll-mt-16","children":[["$","div",null,{"className":"mb-2 text-[0.75rem] font-semibold uppercase tracking-[3px] text-rose","children":"What to expect"}],["$","h2",null,{"className":"mb-3 text-[1.55rem] font-normal leading-tight tracking-wide text-ink md:text-[1.8rem]","children":"How Long You Should Expect for Citizenship Application Processing"}],["$","p",null,{"className":"mb-7 text-[#51596b]","children":"There are a number of factors in the naturalization process that you don't control that affect the timeline. The time it takes to process depends a lot on the workload at the Tampa USCIS field office as well as the FBI background check processing time"}],["$","ol",null,{"className":"ml-4 list-none border-l-2 border-[#e4dfd3]","children":[["$","li","Form N-400 Receipt and Initial Review",{"className":"relative pb-6 pl-9 last:pb-0","children":[["$","span",null,{"className":"absolute -left-[17px] top-0 grid h-8 w-8 place-items-center rounded-full border-2 border-cream bg-ink text-[0.85rem] font-semibold text-white","children":1}],["$","b",null,{"className":"block text-ink","children":"Form N-400 Receipt and Initial Review"}],["$","span",null,{"className":"text-[0.93rem] text-[#51596b]","children":"A physical receipt notice should be received a few weeks after filing. With this document you know that your case is now in the system and have a tracking number."}]]}],["$","li","Biometrics Appointment and Background Checks",{"className":"relative pb-6 pl-9 last:pb-0","children":[["$","span",null,{"className":"absolute -left-[17px] top-0 grid h-8 w-8 place-items-center rounded-full border-2 border-cream bg-ink text-[0.85rem] font-semibold text-white","children":2}],["$","b",null,{"className":"block text-ink","children":"Biometrics Appointment and Background Checks"}],["$","span",null,{"className":"text-[0.93rem] text-[#51596b]","children":"USCIS usually schedules a fingerprinting appointment shortly after they process your payment. This step initiates the mandatory FBI and background security checks required for all applicants."}]]}],["$","li","Naturalization Interview and Examination Scheduling",{"className":"relative pb-6 pl-9 last:pb-0","children":[["$","span",null,{"className":"absolute -left-[17px] top-0 grid h-8 w-8 place-items-center rounded-full border-2 border-cream bg-ink text-[0.85rem] font-semibold text-white","children":3}],["$","b",null,{"className":"block text-ink","children":"Naturalization Interview and Examination Scheduling"}],["$","span",null,{"className":"text-[0.93rem] text-[#51596b]","children":"An interview notice is usually issued several months after your background checks are cleared. The exact wait time depends on how many cases are backlogged at the Tampa field office."}]]}],["$","li","Additional Evidence Requests and Application Review",{"className":"relative pb-6 pl-9 last:pb-0","children":[["$","span",null,{"className":"absolute -left-[17px] top-0 grid h-8 w-8 place-items-center rounded-full border-2 border-cream bg-ink text-[0.85rem] font-semibold text-white","children":4}],["$","b",null,{"className":"block text-ink","children":"Additional Evidence Requests and Application Review"}],["$","span",null,{"className":"text-[0.93rem] text-[#51596b]","children":"The officer might need more information to make a final decision post-interview. They will issue a Request for Evidence in this scenario, which extends the timeline based on how quickly you respond."}]]}],"$L45"]}]]}],"$L46"]}]]}]}]
1f:["$","section",null,{"id":"citizenship-benefits","className":"scroll-mt-16 py-12 md:py-16 border-y border-[#e4dfd3] bg-white","children":["$","div",null,{"className":"mx-auto px-5 max-w-[1080px]","children":[["$","div",null,{"className":"mb-2 text-[0.75rem] font-semibold uppercase tracking-[3px] text-rose","children":"After the oath"}],["$","h2",null,{"className":"mb-3 text-[1.55rem] font-normal leading-tight tracking-wide text-ink md:text-[2rem]","children":"What You Gain the Moment You Take the Oath of Citizenship"}],["$","p",null,{"className":"mb-8 max-w-[700px] text-[1.02rem] text-[#51596b]","children":"Naturalization provides profound legal stability and opens doors to new civic opportunities. The benefits of citizenship drastically change your life and secure your family's future."}],["$","div",null,{"className":"grid gap-4","style":{"gridTemplateColumns":"repeat(auto-fit, minmax(min(300px, 100%), 1fr))"},"children":[["$","article","Eligibility to Apply for a U.S. Passport",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Eligibility to Apply for a U.S. Passport"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Citizens can immediately obtain a U.S. passport after their ceremony. This document offers extensive visa-free travel and guarantees federal protection when you go abroad."}]]}],["$","article","Petitioning for Additional Qualifying Family Members",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Petitioning for Additional Qualifying Family Members"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Citizens have the power to sponsor parents, siblings, and married adult children. Permanent residents do not have the legal authority to sponsor these specific family groups."}]]}],["$","article","Eligibility for Federal Employment Requiring Citizenship",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Eligibility for Federal Employment Requiring Citizenship"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Many prestigious government jobs and intelligence positions are reserved exclusively for U.S. citizens. Citizenship is an absolute prerequisite for obtaining any level of federal security clearance."}]]}],["$","article","Voting Rights in Federal, State, and Local Elections",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Voting Rights in Federal, State, and Local Elections"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"You gain the constitutional right to vote the moment you take the oath. This allows you to participate fully in the democratic process and shape your community's future."}]]}],"$L47","$L48"]}]]}]}]
20:["$","section",null,{"id":"fees-and-waivers","className":"scroll-mt-16 py-12 md:py-16 bg-cream","children":["$","div",null,{"className":"mx-auto px-5 max-w-[1080px]","children":[["$","div",null,{"className":"mb-2 text-[0.75rem] font-semibold uppercase tracking-[3px] text-rose","children":"2026 costs"}],["$","h2",null,{"className":"mb-3 text-[1.55rem] font-normal leading-tight tracking-wide text-ink md:text-[2rem]","children":"Naturalization Fees and Waivers for 2026 Citizenship Applicants"}],["$","p",null,{"className":"mb-8 max-w-[700px] text-[1.02rem] text-[#51596b]","children":"The process of filing for citizenship requires financial planning, as government fees and legal costs add up quickly. You should understand all expected expenses before you begin the paperwork."}],["$","div",null,{"children":[["$","div","USCIS Filing Fee",{"className":"flex flex-col gap-1 border-b border-[#e4dfd3] py-4 sm:flex-row sm:gap-4","children":[["$","b",null,{"className":"min-w-[200px] text-ink","children":"USCIS Filing Fee"}],["$","span",null,{"className":"text-[#51596b]","children":"Form N-400 requires a standard filing fee to process the application. Online filing often features a slight discount compared to mailing a paper application to the lockbox."}]]}],["$","div","Reduced Filing Fee",{"className":"flex flex-col gap-1 border-b border-[#e4dfd3] py-4 sm:flex-row sm:gap-4","children":[["$","b",null,{"className":"min-w-[200px] text-ink","children":"Reduced Filing Fee"}],["$","span",null,{"className":"text-[#51596b]","children":"Applicants with household incomes between 150% and 400% of the Federal Poverty Guidelines receive a break. They may qualify to pay a substantially reduced government fee."}]]}],["$","div","Fee Waiver",{"className":"flex flex-col gap-1 border-b border-[#e4dfd3] py-4 sm:flex-row sm:gap-4","children":[["$","b",null,{"className":"min-w-[200px] text-ink","children":"Fee Waiver"}],["$","span",null,{"className":"text-[#51596b]","children":"Form I-912 allows ap