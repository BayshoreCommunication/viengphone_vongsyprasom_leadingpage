3e:["$","article","Conditional Green Cards With Pending Form I-751 Petitions",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Conditional Green Cards With Pending Form I-751 Petitions"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"You can apply for citizenship while your I-751 is pending as long as you meet the three-year rule. You must wait until the I-751 is adjudicated by USCIS."}]]}]
3f:["$","article","Expired Green Cards and Pending Immigration Matters",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Expired Green Cards and Pending Immigration Matters"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Even if your green card has expired, you will still be a permanent resident. If you have overlapping applications then you will need to take care with the legal process to make sure they do not affect each other adversely."}]]}]
40:["$","article","Conflicting Information in Previous Immigration Records",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Conflicting Information in Previous Immigration Records"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"You will run into major issues if you have conflicting information on your current n-400 application and previous visa applications. The officer will ask you questions about any contradictions with your employment history, home addresses and family members."}]]}]
41:["$","article","Gaps in Employment and Residential History",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-white","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Gaps in Employment and Residential History"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Missing time frames on your N-400 will cause a lot of delays with the background check. This will cause your officer to ask you tough questions during your interview to figure out what is actually going on. Conviction for past immigration offenses can impact a person's naturalization process. These are unauthorized employment and visa overstays. These infractions may be brought to officers' attention during the review and will be used to evaluate your good moral character and immigration law compliance since you got your Green Card."}]]}]
42:["$","article","Missing Documents or Inaccurate Form N-400 Answers",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-white","children":["$undefined",["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Missing Documents or Inaccurate Form N-400 Answers"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"Simple clerical errors or missing translations halt progress immediately. These mistakes result in Requests for Evidence that delay cases by several months."}]]}]
