ame":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":[["$","div",null,{"className":"mb-3 grid h-9 w-9 place-items-center rounded-full bg-rose/15 text-sm font-bold text-rose","children":2}],["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Acquired or Derived Citizenship Through Parents"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"There are some people who are automatically citizens without knowing. You may be automatically derived or acquired citizenship by having a citizen parent. This can depend on the particular laws that are currently in place at the time you were born."}]]}],["$","article","Citizenship for Children Born Abroad to U.S. Citizen Parents",{"className":"rounded-xl border border-[#e4dfd3] p-5 transition hover:-translate-y-1 hover:border-rose hover:shadow-[0_20px_40px_-14px_rgba(0,0,0,0.3)] bg-cream","children":[["$","div",null,{"className":"mb-3 grid h-9 w-9 place-items-center rounded-full bg-rose/15 text-sm font-bold text-rose","children":3}],["$","h3",null,{"className":"mb-2 font-sans text-[1rem] font-semibold leading-snug text-ink","children":"Citizenship for Children Born Abroad to U.S. Citizen Parents"}],["$","p",null,{"className":"text-[0.93rem] leading-relaxed text-[#51596b]","children":"If one or both of a child's parents is a U.S. citizen, the child may be granted citizenship at birth. The U.S. citizen parent must demonstrate that they were physically present in the United States in accordance with certain provisions prior to the birth of the child."}]]}],"$L33","$L34","$L35","$L36"]}]]}]}]
