9:["$","section",null,{"id":"about","className":"page-module__E0kJGG__section page-module__E0kJGG__alt","children":[["$","span",null,{"className":"page-module__E0kJGG__eyebrow","children":"Meet Your Attorney"}],["$","h2",null,{"className":"page-module__E0kJGG__h2","children":"About Attorney Vongsyprasom"}],["$","div",null,{"className":"page-module__E0kJGG__aboutGrid","children":[["$","div",null,{"className":"page-module__E0kJGG__bio","children":[["$","p","0",{"children":"Attorney Vongsyprasom is a compassionate and strategic advocate devoted to helping clients navigate some of life's most challenging legal situations."}],["$","p","1",{"children":"She focuses her practice on U.S. Immigration and Nationality Law, DUI Defense, and Personal Injury Litigation, offering clients the skill, empathy, and dedication they deserve."}],["$","p","2",{"children":"Her immigration practice covers a wide range of cases, including family-based visa petitions, marriage-based green cards, adjustment of status, consular processing, citizenship and naturalization, and waivers of inadmissibility such as I-601 and I-601A."}],["$","p","3",{"children":"She also represents clients in removal (deportation) defense, bond hearings, motions to reopen or reconsider, and humanitarian cases such as VAWA self-petitions, U visas for victims of crime, and humanitarian parole."}],["$","p","4",{"children":"Her deep understanding of the U.S. immigration system and her fierce advocacy style have helped countless families stay together and achieve stability in the United States."}],["$","p","5",{"children":"As a DUI defense attorney, Ms. Vongsyprasom provides strong, client-focused representation for individuals facing charges that threaten their freedom or immigration status."}],["$","p","6",{"children":"In her personal injury practice, Ms. Vongsyprasom brings unique experience as a former staff counsel for Government Employees Insurance Company (GEICO)."}],["$","p","7",{"children":"Before co-founding Tripathi Vongsyprasom Law, P.A., she practiced landlord-tenant disputes, homeowners association defense, family law, and criminal defense."}]]}],["$","aside",null,{"className":"page-module__E0kJGG__aboutSide","children":[["$","h3",null,{"children":"At a Glance"}],["$","ul",null,{"children":[["$","li","0",{"children":[["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","path",null,{"d":"M22 10v6M2 10l10-5 10 5-10 5-10-5z"}],["$","path",null,{"d":"M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5"}]]}],["$","span",null,{"children":"J.D., Western Michigan University Cooley Law School, 2018"}]]}],["$","li","1",{"children":[["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","circle",null,{"cx":"12","cy":"8","r":"4"}],["$","path",null,{"d":"M4 21c0-4 4-6 8-6s8 2 8 6"}]]}],["$","span",null,{"children":"Member, The Florida Bar"}]]}],["$","li","2",{"children":[["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.8,"strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"}]}],["$","span",null,{"children":"Admitted, U.S. Immigration Courts"}]]}],["$","li","3",{"children":[["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.8,"strokeLinecap":"round","strokeLinejoin":"round","children":["$","path",null,{"d":"M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6l8-4z"}]}],["$","span",null,{"children":"Former Staff Counsel, GEICO"}]]}],["$","li","4",{"children":[["$","svg",null,{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.8,"strokeLinecap":"round","strokeLinejoin":"round","children":[["$","circle",null,{"cx":"12","cy":"12","r":"9"}],["$","path",null,{"d":"M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"}]]}],["$",